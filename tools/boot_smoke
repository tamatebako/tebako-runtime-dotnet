# Boot smoke for a built tebako .NET runtime pair (the php factory's
# boot_smoke role, at the repack runtime's scope — stdlib-only):
# boots the wrapper exe against its sibling env image and asserts the
# driver contract end to end. Scenarios:
#
#   bare                 no image: the wrapper NAMES the bare boot
#                        (TEBAKO_RUNTIME_IMAGE unset — the pair contract
#                        is two artifacts; the wrapper without its env
#                        image is a named error, never a shrug)
#   boot                 TEBAKO_RUNTIME_IMAGE handoff: `dotnet --info`
#                        answers off the pair, naming the pinned SDK
#                        version, the carried Microsoft.NETCore.App
#                        shared runtime, and the leg's RID — proof the
#                        exec-cache materialization + the muxer's
#                        self-location work end to end
#   compile              a hand-written console fixture (no template
#                        restore): `dotnet run --project … -c Release`
#                        inside the pair — MSBuild + Roslyn + the
#                        OFFLINE framework resolution against the
#                        bundled packs (Microsoft.NETCore.App.Ref +
#                        the per-RID apphost pack), then the compiled
#                        app executes and reports its own runtime
#   dll                  the compile fixture's built dll executed
#                        directly (`dotnet <dll>`) — the app-payload
#                        execution shape
#   compute-floor        the boot probes are blind to a slow BUILD
#                        (tebako-runtime-python#79's lesson, the php
#                        factory's shape): a fixed pure-compute C# probe
#                        (recursive fib(35), no I/O in the loop) compiled
#                        + executed inside the pair, timed with
#                        Stopwatch INSIDE the process (best of three —
#                        boot/mount cost and one-off scheduling noise
#                        never enter the measurement), against a
#                        per-platform ceiling that is a regression
#                        tripwire, never a benchmark. The probe ALSO
#                        reports RuntimeInformation.ProcessArchitecture:
#                        the repack's slow-compute class is a transplanted
#                        pair running under emulation (an x64 muxer on an
#                        arm64 leg), so the process architecture must be
#                        the leg's OWN. Modes (COMPUTE_FLOOR_MODE):
#                        "fail" (the default) trips the leg; "warn" —
#                        armed by the workflow on the macos-x86_64 leg
#                        ALONE, where the link-unit line carries the LIVE
#                        ~3x slow-compute defect on real Intel silicon
#                        (tebako#1095, still open) — prints a ::warning::
#                        and keeps the leg green. REMOVAL CONDITION: that
#                        leg reverts to fail-closed when tebako#1095
#                        closes.                                         [all]
#   bad-mount            --tebako-image <missing>:-:/nope -> exit 69
#                        (the unavailable image, named on stderr)
#   mount-root-malformed TEBAKO_MOUNT_ROOT=relative/path -> exit 65
#   override-ungranted   TEBAKO_MOUNT_ROOT=<abs> against the dotnet
#                        image -> exit 78 (the image grants no override
#                        — the closed default, spec 00 §9)
#
# The installed-pair scenario (explicit opt-in ONLY — never in "all"):
#
#   published-pair       the acceptance shape through the REAL install
#                        machinery (tebako-runtime-r#6's grammar): a
#                        tebako CLI add-registry + install dotnet into a
#                        scratch TEBAKO_HOME, then the materialized
#                        <home>/shims/dotnet answers --info and compiles
#                        + runs the hello/console fixture (MSBuild +
#                        Roslyn offline against the bundled packs — the
#                        real compute probe), reporting its own
#                        framework + RID. The build-tree scenarios above
#                        cannot see this flow: what they boot is the
#                        freshly built pair off TEBAKO_RUNTIME_IMAGE;
#                        what a user runs is the registry default's
#                        bytes, fetched + mounted by the loader and
#                        dispatched by the shim — the tebako-runtime-r#5
#                        class (a published pair that answers the fast
#                        path and dies on real execution) ships green in
#                        the former and dies in the latter. publish.yml's
#                        acceptance job runs this scenario per leg once
#                        the registry row lands on main; run by hand it
#                        exercises whatever pair the registry default
#                        names NOW.
#
# The windows legs run the SAME scenario set — the PE/ucrt materialize
# path IS the boot under test (exec-cache materializes the image's tree
# host-real; the muxer + hostfxr + coreclr load from it). Every windows
# boot's PATH is scrubbed to the Windows system directories (System32 +
# the Windows root + Wbem) — no mingw/msys toolchain directory, the
# audience-rule condition (the python factory's grammar); and the CLI's
# HOME/NuGet/exec-cache roots ride the smoke's scratch via
# USERPROFILE/TMP/TEMP (native windows processes ignore HOME/TMPDIR).
#
# Usage:
#   tools/boot_smoke [--runtime-root DIR | --exe PATH]
#                    [--scenario all|bare|boot|compile|dll|compute-floor|
#                               bad-mount|mount-root-malformed|override-ungranted|
#                               published-pair]
#                    [--tebako PATH] [--registry REF] [--home DIR]
#
# (--tebako/--registry/--home serve the published-pair scenario only.)
#
# Exit codes: 0 green · 141 usage/resolution · 143 a scenario failed.

require "fileutils"
require "open3"
require "optparse"
require "rbconfig"
require "tmpdir"
require "yaml"

REPO_ROOT = File.expand_path("..", __dir__).freeze
$LOAD_PATH.unshift(File.join(REPO_ROOT, "build", "lib"))

require "tebako_dotnet_builder"

# The exec-cache first materialization copies the pruned SDK tree
# (~0.5 GB) once per TMPDIR; later boots reuse the content-keyed cache.
# The compile scenario adds MSBuild/Roslyn on top. Error scenarios exit
# before any of that.
BOOT_TIMEOUT = 900
ERROR_TIMEOUT = 60

# The compute-floor scenario (the header's tebako-runtime-python#79
# block): fib(COMPUTE_FIB_N) inner-timed, best of COMPUTE_FIB_RUNS. The
# ceiling is per-platform (a healthy JIT leg measures ~0.5-1 s; the
# recorded values carry several-x headroom — a tripwire, never a
# benchmark bound) and keyed by the pair's asset platform; a platform
# with no recorded ceiling is a named error, never a silent default.
COMPUTE_FIB_N = 35
COMPUTE_FIB_RUNS = 3
COMPUTE_FLOOR_SECONDS = {
  "linux-gnu-x86_64" => 4.0,
  "linux-musl-x86_64" => 4.0,
  "macos-arm64" => 4.0,
  "macos-x86_64" => 4.0,
  "windows-ucrt64" => 4.0,
  "windows-ucrt-arm64" => 4.0
}.freeze

IMAGE_SUFFIXES = %w[.tfs .dwarfs].freeze
MARKER_SUFFIXES = %w[.sha256 .json .yaml .asc].freeze
NON_EXECUTABLE_SUFFIXES = (IMAGE_SUFFIXES + MARKER_SUFFIXES).freeze

# The published-pair scenario's default registry: THIS factory's live
# registry (the resolver fetches it at its default branch).
DEFAULT_REGISTRY = "tfs:github:tamatebako/tebako-runtime-dotnet"

# The child env is REPLACED, not inherited: any tebako/preload leftovers
# a host setup would leak in are scrubbed (the ruby factory's msys
# GEM_HOME lesson).
ENV_SCRUBBED = %w[LD_PRELOAD DYLD_INSERT_LIBRARIES DYLD_FALLBACK_LIBRARY_PATH].freeze

# The host platform probe (the windows adjustments below): msys/mingw
# rubies report msys/mingw host_os — the runner's hosted ruby on every
# windows leg included.
WINDOWS_HOST = !!(RbConfig::CONFIG["host_os"] =~ /mswin|msys|mingw|cygwin/i)

def usage_error(message)
  warn "boot_smoke: #{message}"
  exit 141
end

# The compute-floor scenario's mode (its header block): "fail" — the
# default, and every leg's shape but one — trips the leg on a breached
# floor; "warn" prints the measurement + a workflow-command ::warning::
# and keeps the leg green. The workflow arms "warn" on the macos-x86_64
# leg ALONE: the live tebako#1095 slow-compute defect (the product
# repo's, in the link-unit line this factory pins) would otherwise red
# that leg until the fix ships. REMOVAL CONDITION: the leg reverts to
# fail-closed when tebako#1095 closes. Any other value is a named error,
# never a silent fallback.
COMPUTE_FLOOR_MODE = ENV.fetch("COMPUTE_FLOOR_MODE", "fail")
unless %w[fail warn].include?(COMPUTE_FLOOR_MODE)
  usage_error("COMPUTE_FLOOR_MODE=#{COMPUTE_FLOOR_MODE.inspect} — known: fail (the default), warn")
end

options = { runtime_root: ENV.fetch("TEBAKO_RUNTIME_ROOT", nil), exe: nil, scenario: "all",
            tebako: nil, registry: DEFAULT_REGISTRY, home: nil }
OptionParser.new do |opts|
  opts.banner = "Usage: tools/boot_smoke [options]"
  opts.on("--runtime-root DIR", "Directory holding exactly one tebako-runtime-* executable") { |v| options[:runtime_root] = v }
  opts.on("--exe PATH", "The runtime executable itself (wins over --runtime-root)") { |v| options[:exe] = v }
  opts.on("--scenario NAME", "One scenario to run (default: all)") { |v| options[:scenario] = v }
  opts.on("--tebako PATH", "tebako CLI for the published-pair scenario (default: TEBAKO_CLI, then tebako on PATH)") do |v|
    options[:tebako] = v
  end
  opts.on("--registry REF", "Registry the published-pair scenario installs from (default: #{DEFAULT_REGISTRY})") do |v|
    options[:registry] = v
  end
  opts.on("--home DIR", "TEBAKO_HOME for the published-pair scenario (default: a mktmpdir)") { |v| options[:home] = v }
  opts.on("-h", "--help") do
    puts opts
    exit 0
  end
end.parse!

def resolve_executable(root, exe)
  return File.expand_path(exe) if exe && File.file?(exe)
  usage_error("--exe #{exe.inspect} is not a file") if exe
  usage_error("no --runtime-root/--exe (TEBAKO_RUNTIME_ROOT unset)") if root.to_s.empty? || !File.exist?(root)
  return File.expand_path(root) if File.file?(root)

  candidates = Dir.glob(File.join(root, "tebako-runtime-*"))
                  .select { |path| File.file?(path) && !NON_EXECUTABLE_SUFFIXES.include?(File.extname(path)) }
  usage_error("no tebako runtime executable under #{root}") if candidates.empty?
  usage_error("several runtime executables under #{root} (#{candidates.join(", ")})") if candidates.length > 1

  File.expand_path(candidates.first)
end

# One scratch tree for the whole smoke: the hermetic exec-cache TMPDIR
# (TEBAKO_EXEC_CACHE is the driver's EXPORT, never an input — naming
# TMPDIR is the hermetic shape, the openjdk grammar), the dotnet CLI's
# HOME, and the compile fixture all live here.
SCRATCH = Dir.mktmpdir("tebako-dotnet-boot-smoke")
at_exit { FileUtils.rm_rf(SCRATCH) }

def boot(executable, argv, env_extra, timeout: BOOT_TIMEOUT)
  Dir.mktmpdir("tebako-dotnet-boot-cwd") do |cwd|
    env = ENV_SCRUBBED.to_h { |key| [key, nil] }
    ENV.each_key { |key| env[key] = nil if key.start_with?("TEBAKO_", "DOTNET_") }
    env.merge!(dotnet_cli_env.merge(env_extra))
    # The windows legs' hostile PATH (the python factory's grammar): EVERY
    # booted runtime sees only the Windows system directories — the
    # audience-rule condition (a bare windows machine carries no mingw/msys
    # toolchain directory). The exec-cache materialized tree is host-real,
    # so the muxer's own DLL closure binds from there.
    env["PATH"] = windows_system_path if WINDOWS_HOST
    # popen3 + a wait-deadline poll, NOT Timeout.timeout around capture3:
    # the Timeout unwind lands in popen3's ensure (wait_thr.join on the
    # still-immortal child) and blocks forever there (the tebako#527 gnu
    # shape). Past the deadline the child is hard-killed and reaped
    # BEFORE any unwind touches popen3's ensure.
    out = err = status = nil
    Open3.popen3(env, executable, *argv, chdir: cwd) do |stdin, stdout, stderr, wait_thr|
      stdin.close
      readers = [stdout, stderr].map { |io| Thread.new { io.read } }
      deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout
      loop do
        break if wait_thr.join(0.1)
        next unless Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

        Process.kill("KILL", wait_thr.pid)
        wait_thr.join
        readers.each(&:kill)
        return ["", "boot_smoke: runtime did not exit within #{timeout}s (hard-killed)", nil]
      end
      out, err = readers.map(&:value)
      status = wait_thr.value
    end
    [out, err, status]
  end
end

# The PATH a windows boot gets on this leg: the Windows system directories
# only (System32, the Windows root, Wbem) — never a mingw/msys toolchain
# directory (the python grammar, issue-55's shape).
def windows_system_path
  root = ENV.fetch("SystemRoot", ENV.fetch("SYSTEMROOT", "C:\\Windows"))
  "#{root}\\System32;#{root};#{root}\\System32\\Wbem"
end

# The hermetic dotnet CLI env (every scenario): no telemetry, no logo,
# no first-run side effects; the CLI's HOME/NuGet caches and the
# driver-named exec cache live under the smoke's scratch tree. On
# windows the native consumers read USERPROFILE/TMP/TEMP (HOME/TMPDIR
# are msys-only there), so the same roots ride the native spellings.
def dotnet_cli_env
  home = File.join(SCRATCH, "home")
  nuget = File.join(SCRATCH, "nuget")
  FileUtils.mkdir_p([home, nuget])
  env = {
    "HOME" => home,
    "NUGET_PACKAGES" => nuget,
    "TMPDIR" => SCRATCH,
    "DOTNET_CLI_TELEMETRY_OPTOUT" => "1",
    "DOTNET_NOLOGO" => "1",
    "DOTNET_SKIP_FIRST_TIME_EXPERIENCE" => "1"
  }
  env.merge!("USERPROFILE" => home, "TMP" => SCRATCH, "TEMP" => SCRATCH) if WINDOWS_HOST
  env
end

$failures = 0
def check(name, ok, detail)
  if ok
    puts "ok   #{name}"
  else
    puts "FAIL #{name}: #{detail}"
    $failures += 1
  end
end

def expect_exit(name, out, err, status, code)
  check(name, status&.exitstatus == code,
        "expected exit #{code}, got #{status&.exitstatus.inspect}\nstdout: #{out}\nstderr: #{err}")
end

def expect_ok(name, out, err, status, marker)
  ok = status&.exitstatus&.zero? && out.include?(marker)
  check(name, ok, "expected exit 0 + #{marker.inspect}\nstdout: #{out}\nstderr: #{err}")
end

# The compile fixture: a hand-written console project (no `dotnet new`
# template restore — the fixture is two files). net<line> tracks the
# pinned SDK's line; the app reports its own framework + RID so the
# assertion is content, not exit code.
def compile_fixture(dir, line)
  File.write(File.join(dir, "hello.csproj"), <<~XML)
    <Project Sdk="Microsoft.NET.Sdk">
      <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net#{line}.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
      </PropertyGroup>
    </Project>
  XML
  File.write(File.join(dir, "Program.cs"), <<~CS)
    using System.Runtime.InteropServices;
    Console.WriteLine($"TEBAKO-DOTNET-OK {RuntimeInformation.FrameworkDescription} {RuntimeInformation.RuntimeIdentifier}");
  CS
end

# The compute-floor probe (the scenario's header block): fib(35) — the
# covenant's steady.cpu shape, no I/O in the loop — timed INSIDE the
# process (Stopwatch around each run): the boot/mount cost and the
# harness never enter the measurement, and best-of-N drops one-off
# scheduling noise. The accumulator keeps the recursion live against
# dead-code elimination; the architecture line is the emulation tripwire
# (a transplanted pair reports the FOREIGN process architecture).
def compute_fixture(dir, line)
  File.write(File.join(dir, "compute.csproj"), <<~XML)
    <Project Sdk="Microsoft.NET.Sdk">
      <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net#{line}.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
      </PropertyGroup>
    </Project>
  XML
  File.write(File.join(dir, "Program.cs"), <<~CS)
    using System.Diagnostics;
    using System.Runtime.InteropServices;

    static long Fib(int n) => n < 2 ? n : Fib(n - 1) + Fib(n - 2);

    long acc = 0;
    var runs = new List<double>();
    for (var i = 0; i < #{COMPUTE_FIB_RUNS}; i++)
    {
        var t0 = Stopwatch.GetTimestamp();
        acc += Fib(#{COMPUTE_FIB_N});
        runs.Add(Stopwatch.GetElapsedTime(t0).TotalSeconds);
    }
    Console.WriteLine("COMPUTE-FLOOR");
    Console.WriteLine($"arch: {RuntimeInformation.ProcessArchitecture}/{RuntimeInformation.OSArchitecture}");
    Console.WriteLine("runs: " + string.Join(" ", runs.Select(r => r.ToString("F3"))));
    Console.WriteLine($"best: {runs.Min():F3}");
    Console.WriteLine($"acc: {acc}");
  CS
end

KNOWN_SCENARIOS = %w[bare boot compile dll compute-floor bad-mount mount-root-malformed override-ungranted].freeze
# The installed-pair scenario (the header block): explicit opt-in ONLY.
# "all" stays the build-tree set — on PR CI it runs against the freshly
# built pair, and installing whatever the registry default names (the
# PREVIOUS release) would gate the PR on stale bytes.
INSTALL_SCENARIOS = %w[published-pair].freeze

def selected_scenarios(only)
  return KNOWN_SCENARIOS.dup if only == "all"
  return [only] if (KNOWN_SCENARIOS + INSTALL_SCENARIOS).include?(only)

  usage_error("unknown scenario '#{only}' (known: #{(KNOWN_SCENARIOS + INSTALL_SCENARIOS + ["all"]).join(", ")})")
end

# --- the published-pair scenario (the header's installed-pair block) ---

def resolve_tebako_cli(requested)
  candidate = requested || ENV.fetch("TEBAKO_CLI", nil) || "tebako"
  return File.expand_path(candidate) if File.file?(candidate) && File.executable?(candidate)

  ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).each do |dir|
    path = File.join(dir, candidate)
    return path if File.file?(path) && File.executable?(path)
  end
  usage_error("no tebako CLI resolvable (#{candidate}) — the published-pair scenario drives the install " \
              "machinery (--tebako / TEBAKO_CLI; tamatebako/tebako's releases ship the per-platform CLI)")
end

# The child env for the CLI steps + the shim probes: boot()'s scrub
# (tebako/preload leftovers never leak in), the hermetic dotnet CLI env
# (the scenario's own scratch HOME/NuGet/exec-cache roots), and
# TEBAKO_HOME pointed at the scenario's store.
def cli_env(home)
  env = ENV_SCRUBBED.to_h { |key| [key, nil] }
  ENV.each_key { |key| env[key] = nil if key.start_with?("TEBAKO_", "DOTNET_") }
  env.merge!(dotnet_cli_env)
  env["TEBAKO_HOME"] = home
  env
end

# The install steps are GATES: a red add-registry/install leaves the
# exec probes nothing to run against — record the failure, name the
# step, and stop the scenario there.
def cli_gate(name, tebako, home, argv)
  out, err, st = Open3.capture3(cli_env(home), tebako, *argv)
  check("published-pair: #{name}", st&.exitstatus&.zero?,
        "exit #{st.exitstatus.inspect}\nstdout: #{out}\nstderr: #{err}")
  return if st&.exitstatus&.zero?

  puts "boot_smoke: the install gate failed — the exec probes need the installed pair"
  exit 143
end

# A whole-line matcher (tebako-runtime-r#6's grammar): build noise and
# the CLI's own chatter surround the probe output, so a probe matches
# only a WHOLE output line, never a substring.
def expect_output_line(name, out, err, status, pattern)
  lines = out.delete("\r").lines.map(&:strip)
  match = lines.find { |line| line.match?(pattern) }
  check(name, status&.exitstatus&.zero? && !match.nil?,
        "expected exit 0 + an output line matching #{pattern.inspect}\nstdout: #{out}\nstderr: #{err}")
  match
end

def run_published_pair(options)
  tebako = resolve_tebako_cli(options[:tebako])
  registry = options[:registry]
  puts "-- Published-pair acceptance: #{tebako} installing from #{registry}"
  body = ->(home) { published_pair_checks(tebako, registry, home) }
  if options[:home]
    body.call(File.expand_path(options[:home]))
  else
    Dir.mktmpdir("tebako-dotnet-published-pair", &body)
  end
end

def published_pair_checks(tebako, registry, home)
  cli_gate("add-registry #{registry}", tebako, home, ["add-registry", registry])
  cli_gate("install dotnet (the registry default)", tebako, home, ["install", "dotnet"])

  shim = File.join(home, "shims", "dotnet")
  check("published-pair: the shim materialized", File.file?(shim), "no #{shim} after a green install")
  unless File.file?(shim)
    puts "boot_smoke: no shim to run the exec probes against"
    exit 143
  end

  env = cli_env(home)
  # --info through the shim: the dispatch + the exec-cache
  # materialization + the muxer's self-location, installed shape. The
  # SDK band the fixture targets is DISCOVERED from this answer, never
  # assumed — the acceptance compiles against what the registry default
  # actually installed.
  out, err, st = Open3.capture3(env, shim, "--info")
  expect_ok("published-pair: dotnet --info answers through the shim", out, err, st, ".NET SDK")
  band = out[/^\s*Version:\s+(\d+\.\d+)\.\d+/, 1]
  unless st&.exitstatus&.zero? && band
    puts "boot_smoke: --info named no SDK band — the console probe has no fixture line"
    exit 143
  end

  # The hello/console compute probe: the hand-written fixture compiles
  # (MSBuild + Roslyn + the OFFLINE framework resolution against the
  # bundled packs) and executes through the installed pair — the
  # build-tree compile scenario's flow, driven by the shim a user gets.
  fixture = File.join(SCRATCH, "published-fixture")
  FileUtils.mkdir_p(fixture)
  compile_fixture(fixture, band)
  out, err, st = Open3.capture3(env, shim, "run", "--project", fixture, "-c", "Release")
  line = expect_output_line("published-pair: the console probe compiles + runs through the shim",
                            out, err, st, /\ATEBAKO-DOTNET-OK \.NET \S+ \S+\z/)
  return unless line

  # The emulation tripwire (the compute-floor scenario's class): a pair
  # transplanted under emulation reports the FOREIGN arch in the app's
  # own RuntimeIdentifier — the host's own must answer.
  expected = RbConfig::CONFIG["host_cpu"] =~ /arm64|aarch64/i ? "arm64" : "x64"
  check("published-pair: the app's RID is the host's own architecture (no emulation tax)",
        line.end_with?("-#{expected}"),
        "expected the RID to end -#{expected}\nline: #{line}\nstdout: #{out}\nstderr: #{err}")
end

def run_scenarios(executable, image, version, runtime_version, rid, line, asset_platform, selected)
  selected.each do |scenario|
    case scenario
    when "bare"
      out, err, st = boot(executable, ["--tebako-entry", "dotnet", "--info"], {}, timeout: ERROR_TIMEOUT)
      check("bare: the wrapper names the missing env image",
            !st&.exitstatus&.zero? && err.include?("TEBAKO_RUNTIME_IMAGE"),
            "exit #{st&.exitstatus.inspect}\nstdout: #{out}\nstderr: #{err}")
    when "boot"
      out, err, st = boot(executable, ["--tebako-entry", "dotnet", "--info"],
                          { "TEBAKO_RUNTIME_IMAGE" => image })
      expect_ok("boot: dotnet --info answers off the pair", out, err, st, ".NET SDK")
      check("boot: the pinned SDK version answers", out.include?("Version:        #{version}") || out.include?(version),
            "--info output:\n#{out}")
      check("boot: the carried shared runtime answers", out.include?("Microsoft.NETCore.App #{runtime_version}"),
            "--info output:\n#{out}")
      check("boot: the leg's RID answers", out.include?("RID:         #{rid}") || out.include?(rid),
            "--info output:\n#{out}")
    when "compile"
      fixture = File.join(SCRATCH, "fixture")
      FileUtils.mkdir_p(fixture)
      compile_fixture(fixture, line)
      out, err, st = boot(executable,
                          ["--tebako-entry", "dotnet", "run", "--project", fixture, "-c", "Release"],
                          { "TEBAKO_RUNTIME_IMAGE" => image })
      expect_ok("compile: dotnet run builds + executes the fixture inside the pair",
                out, err, st, "TEBAKO-DOTNET-OK")
      check("compile: the app reports the carried runtime", out.include?(runtime_version),
            "stdout: #{out}\nstderr: #{err}")
      check("compile: the app reports the leg's RID", out.include?(rid),
            "stdout: #{out}\nstderr: #{err}")
    when "dll"
      fixture = File.join(SCRATCH, "fixture")
      unless File.file?(File.join(fixture, "hello.csproj"))
        check("dll", false, "the compile scenario did not leave its fixture — run compile first (or all)")
        next
      end

      out_dir = File.join(SCRATCH, "fixture-out")
      out, err, st = boot(executable,
                          ["--tebako-entry", "dotnet", "build", fixture, "-c", "Release", "-o", out_dir],
                          { "TEBAKO_RUNTIME_IMAGE" => image })
      check("dll: dotnet build produced the fixture dll", st&.exitstatus&.zero? && File.file?(File.join(out_dir, "hello.dll")),
            "exit #{st&.exitstatus.inspect}\nstdout: #{out}\nstderr: #{err}")
      out, err, st = boot(executable,
                          ["--tebako-entry", "dotnet", File.join(out_dir, "hello.dll")],
                          { "TEBAKO_RUNTIME_IMAGE" => image })
      expect_ok("dll: dotnet <dll> executes the built fixture", out, err, st, "TEBAKO-DOTNET-OK")
    when "compute-floor"
      fixture = File.join(SCRATCH, "compute-fixture")
      FileUtils.mkdir_p(fixture)
      compute_fixture(fixture, line)
      out_dir = File.join(SCRATCH, "compute-out")
      out, err, st = boot(executable,
                          ["--tebako-entry", "dotnet", "build", fixture, "-c", "Release", "-o", out_dir],
                          { "TEBAKO_RUNTIME_IMAGE" => image })
      dll = File.join(out_dir, "compute.dll")
      check("compute-floor: dotnet build produced the probe dll", st&.exitstatus&.zero? && File.file?(dll),
            "exit #{st&.exitstatus.inspect}\nstdout: #{out}\nstderr: #{err}")
      next unless File.file?(dll)

      out, err, st = boot(executable, ["--tebako-entry", "dotnet", dll],
                          { "TEBAKO_RUNTIME_IMAGE" => image })
      expect_ok("compute-floor", out, err, st, "COMPUTE-FLOOR")
      out = out.delete("\r")
      # The repack's slow-compute class (the scenario's header block): a
      # pair transplanted under emulation reports the FOREIGN process
      # architecture — the leg's own must answer.
      expected_arch = asset_platform.include?("arm64") ? "Arm64" : "X64"
      check("compute-floor: the process architecture is the leg's own (no emulation tax)",
            out.include?("arch: #{expected_arch}/"),
            "expected arch: #{expected_arch}/…\nstdout: #{out}\nstderr: #{err}")
      puts "     compute-floor: fib(#{COMPUTE_FIB_N}) #{out[/^runs: (.+)$/, 1]}"
      best = out[/^best: (\d+(?:\.\d+)?)$/, 1]&.to_f
      ceiling = COMPUTE_FLOOR_SECONDS.fetch(asset_platform) do
        usage_error("no compute-floor ceiling recorded for #{asset_platform} — record this leg's ceiling in tools/boot_smoke")
      end
      floor = "compute-floor: fib(#{COMPUTE_FIB_N}) best-of-#{COMPUTE_FIB_RUNS} under #{ceiling}s"
      detail = "measured best #{best.inspect}s (runs in the log above) — a leg computing at a fraction " \
               "of the matrix's rate is a slow BUILD, never a publishable artifact " \
               "(tebako-runtime-python#79's lesson)\nstdout: #{out}\nstderr: #{err}"
      if best.nil? || best > ceiling
        if COMPUTE_FLOOR_MODE == "warn"
          # The warn tier (the header block + the mode comment): the
          # defect is LIVE on this leg's class, the root cause is the
          # product repo's — the measurement and a workflow-command
          # warning carry it, the leg stays green.
          puts "::warning title=compute-floor::fib(#{COMPUTE_FIB_N}) best #{best.inspect}s past the " \
               "#{ceiling}s tripwire — the live tebako#1095 slow-compute defect on real " \
               "Intel silicon; this leg rides warn-only until tebako#1095 closes"
          puts "warn #{floor}: #{detail}"
        else
          check(floor, false, detail)
        end
      else
        check(floor, true, detail)
      end
    when "bad-mount"
      missing = File.join(SCRATCH, "no-such-image.tfs")
      out, err, st = boot(executable,
                          ["--tebako-image", "#{missing}:-:/nope", "--tebako-entry", "dotnet", "--info"],
                          { "TEBAKO_RUNTIME_IMAGE" => image }, timeout: ERROR_TIMEOUT)
      expect_exit("bad-mount", out, err, st, 69)
      check("bad-mount: the image is named", err.include?(missing), "stderr: #{err}")
    when "mount-root-malformed"
      out, err, st = boot(executable, ["--tebako-entry", "dotnet", "--info"],
                          { "TEBAKO_RUNTIME_IMAGE" => image, "TEBAKO_MOUNT_ROOT" => "relative/path" },
                          timeout: ERROR_TIMEOUT)
      expect_exit("mount-root-malformed", out, err, st, 65)
      check("mount-root-malformed: the variable is named", err.include?("TEBAKO_MOUNT_ROOT"), "stderr: #{err}")
    when "override-ungranted"
      out, err, st = boot(executable, ["--tebako-entry", "dotnet", "--info"],
                          { "TEBAKO_RUNTIME_IMAGE" => image,
                            "TEBAKO_MOUNT_ROOT" => File.join(SCRATCH, "elsewhere") },
                          timeout: ERROR_TIMEOUT)
      expect_exit("override-ungranted (the image grants no override — the closed default)", out, err, st, 78)
    end
  end
end

selected = selected_scenarios(options[:scenario])
if selected == INSTALL_SCENARIOS
  run_published_pair(options)
else
  executable = resolve_executable(options[:runtime_root], options[:exe])
  image = "#{executable.sub(/\.exe\z/, "")}.tfs"
  usage_error("no sibling env image #{image}") unless File.file?(image)

  contract = TebakoDotnetBuilder::Contract.new(File.join(REPO_ROOT, "contract.yml"))
  pins = TebakoDotnetBuilder::Pins.new(File.join(REPO_ROOT, "versions.yml"))
  stem = File.basename(executable).sub(/\.exe\z/, "")
  rest = stem.sub(/\Atebako-runtime-\d+\.\d+\.\d+-dotnet-/, "")
  usage_error("the exe name #{stem} is not the runtime naming grammar") if rest == stem
  # rest is "<sdk-version>-<asset-platform>"; the asset platform is the
  # longest known suffix (windows-ucrt64 nests no arch segment).
  asset_platform = TebakoDotnetBuilder::Platform::ASSET_PLATFORMS.values
                   .select { |ap| rest.end_with?("-#{ap}") }.max_by(&:length)
  usage_error("the exe name #{stem} carries no known asset platform") if asset_platform.nil?
  version = rest.delete_suffix("-#{asset_platform}")
  usage_error("the exe's SDK version #{version} is not in contract.yml's catalog") unless contract.catalog.include?(version)
  triplet = TebakoDotnetBuilder::Platform.triplet_for_asset_platform(asset_platform)
  rid = pins.source(version, triplet).rid
  line = pins.line(version)
  runtime_version = pins.runtime_version(version)

  puts "-- Boot smoke: #{executable} (#{asset_platform}, SDK #{version}, runtime #{runtime_version})"
  run_scenarios(executable, image, version, runtime_version, rid, line, asset_platform, selected)
end

if $failures.positive?
  puts "#{$failures} scenario check(s) failed"
  exit 143
end
puts "boot smoke: all green"
exit 0
